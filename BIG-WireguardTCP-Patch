+	if (sock && sock->sk) {
+		sk = sock->sk;
+		user_data = (struct wg_socket_data *)sk->sk_user_data;
+		tcp_state = (sk->sk_protocol == IPPROTO_TCP) ? sk->sk_state : -1;
